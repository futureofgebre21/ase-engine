# Copy this file to .env and fill in the key. Never commit .env.
# Without a provider the app still starts, but it cannot audit (it says so, it never fakes).

# --- AI model (OpenAI-compatible server). Hackathon values for Baseten + Meta Muse Spark Open:
ASE_LLM_PROVIDER=openai_compatible
ASE_LLM_BASE_URL=https://inference.baseten.co/v1
ASE_LLM_MODEL=meta-models/muse-spark-open-1026
ASE_LLM_API_KEY=
# Reasoning models spend output tokens thinking; raise this if replies come back empty.
ASE_LLM_MAX_OUTPUT_TOKENS=8000
ASE_LLM_TIMEOUT_SECONDS=300

# --- GitHub (optional, least-privilege fine-grained token; only needed for push):
# ASE_GITHUB_TOKEN=

ASE_WORKSPACE_ROOT=workspaces
ASE_MAX_REPAIR_ATTEMPTS=2
ASE_ALLOW_CODE_EXECUTION=false
# Windows only: set to false if git clone fails with CRYPT_E_REVOCATION_OFFLINE.
# This stops checking for revoked certificates (encryption and hostname checks stay on).
# ASE_GIT_CHECK_CERT_REVOCATION=true
